{
  "name": "ops-copilot",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/index.ts",
    "arena": "tsx --env-file-if-exists=.env src/arena.ts",
    "bench": "tsx --env-file-if-exists=.env src/bench.ts",
    "test": "node --import tsx --test \"src/**/*test.ts\"",
    "typecheck": "tsc --noEmit",
    "guard": "tsx scripts/ops-copilot-guard.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts"
  },
  "type": "module",
  "dependencies": {
    "@langchain/core": "^1.2.18",
    "@langchain/langgraph": "^1.5.1",
    "@langchain/openai": "^1.6.2",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "sequelize": "^6.37.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
